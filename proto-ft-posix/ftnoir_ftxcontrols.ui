   <item>
    <widget class="QGroupBox" name="groupBox">
     <property name="title">
      <string>opentrackclient 1.0</string>
     </property>
     <layout class="QGridLayout" name="gridLayout_2">
      <item row="1" column="0">
       <widget class="QLabel" name="label">
        <property name="text">
         <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;opentrackclient 1.0&lt;/span&gt;&lt;/p&gt;&lt;p&gt;This module is aimed for native clients using opentrack's &lt;a href=&quot;https://github.com/matatata/opentrack/tree/master/opentrackclient&quot;&gt;&lt;span style=&quot; text-decoration: underline; color:#1f9b5d;&quot;&gt;opentrackclient library&lt;/span&gt;&lt;/a&gt;. As an example Opentrack's &lt;span style=&quot; font-weight:700;&quot;&gt;X-Plane&lt;/span&gt; plugin now uses this library.&lt;br/&gt;This approach resembles how freetrack and other popular headtracking solutions are integrate with games on the Windows platform.&lt;br/&gt;I invite developers to bring native headtracking to native macOS and Linux.&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Games run via Wine&lt;/span&gt;&lt;/p&gt;&lt;p&gt;Together with &lt;a href=&quot;https://matatata.gumroad.com/l/opentrackwinebridge&quot;&gt;&lt;span style=&quot; text-decoration: underline; color:#1f9b5d;&quot;&gt;Wine-Bridge&lt;/span&gt;&lt;/a&gt; this module can be used with Windows games running on macOS or Linux via Wine based solutions such as &lt;a href=&quot;https://www.codeweavers.com/crossover&quot;&gt;&lt;span style=&quot; text-decoration: underline; color:#1f9b5d;&quot;&gt;CrossOver&lt;/span&gt;&lt;/a&gt; or Steam's Proton on Linux.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QDialogButtonBox" name="buttonBox">
     <property name="sizePolicy">
      <sizepolicy hsizetype="Expanding" vsizetype="Maximum">
       <horstretch>0</horstretch>
       <verstretch>0</verstretch>
      </sizepolicy>
     </property>
     <property name="standardButtons">
      <set>QDialogButtonBox::StandardButton::Close</set>
     </property>
    </widget>
   </item>
